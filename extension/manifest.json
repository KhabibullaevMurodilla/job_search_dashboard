{
  "manifest_version": 3,
  "name": "Sponsor Check for job-radar",
  "version": "1.0.0",
  "description": "While you browse job postings: a sponsorship-likelihood and CV-fit badge, scored the same way job-radar's own dashboard scores it. Runs entirely in your browser -- your CV and the postings you read never leave it.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.gov.uk/*",
    "https://assets.publishing.service.gov.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.google.com/*", "*://mail.google.com/*", "*://*.gmail.com/*",
        "*://chrome.google.com/*", "*://*.slack.com/*", "*://*.zoom.us/*",
        "*://*.facebook.com/*", "*://*.youtube.com/*", "*://*.netflix.com/*"
      ],
      "js": ["content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": []
}
